{
  "formatVersion": 2,
  "id": "com.toolbox.keyboard-test",
  "name": "Keyboard & Mouse Test",
  "version": "0.2.3",
  "pluginApiMajor": 1,
  "publisher": "toolbox.official",
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": {
    "supportedModes": [
      "outOfProcess"
    ],
    "preferredMode": "outOfProcess",
    "background": false
  },
  "capabilities": [{
    "id": "host.ui.input-events",
    "required": true,
    "reason": "Displays keyboard and pointer events explicitly forwarded to the plugin UI by ToolBox Host."
  }],
  "entryPoint": "KeyboardTestPlugin.KeyboardTestPlugin, KeyboardTest"
}
